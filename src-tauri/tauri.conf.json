{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plurivex",
  "version": "0.1.0",
  "identifier": "com.plurivex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Plurivex",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:wallet_inspector.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Plurivex Labs. All rights reserved.",
    "category": "Finance",
    "shortDescription": "Multi-Chain Desktop Security Vault & Forensic Tool",
    "longDescription": "High-performance non-custodial multi-chain wallet inspector, forensic mnemonic recovery, and batch sweep suite.",
    "publisher": "Plurivex Labs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}